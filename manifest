title=ShaGa IPTV Player
major_version=1
minor_version=1
build_version=1

' Channel icon (PNG with a transparent background)
' Значок приложения (PNG с прозрачным фоном)
mm_icon_focus_hd=pkg:/images/icon.png

' Enable audio metadata support
' Включить поддержку аудиометаданных
requires_audiometadata=true

' Splash screen displayed during application startup
' Заставка, отображаемая при запуске приложения
splash_screen_fhd=pkg:/images/splash_screen_hd2.jpg
splash_screen_hd=pkg:/images/splash_screen_hd2.jpg
splash_color=#808080
splash_min_time=0

' Supported user interface resolution
' Поддерживаемое разрешение пользовательского интерфейса
ui_resolutions=fhd

' Enable input launch and deep linking support
' Включить поддержку запуска через внешние события и deep linking
supports_input_launch=1